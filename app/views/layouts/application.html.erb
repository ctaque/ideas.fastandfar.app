<!DOCTYPE html>
<html>
  <head>
    <script>
      (function () {
        var theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
      })();
    </script>

    <title><%= content_for(:title) || "Ideas, Features and bugs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Ideas, Features and bugs">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="fastandfarapp-origin" content="<%= Rails.application.config.x.fastandfarapp_origin %>">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="gh-header">
      <%= link_to root_path, class: "brand" do %>
        <span class="brand-mark">I</span>
        Ideas, Features and bugs
      <% end %>

      <div class="actions">
        <details class="dropdown theme-switcher">
          <summary class="btn btn-sm" aria-label="Changer de thème">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M8 1.7a6.3 6.3 0 0 1 0 12.6Z" fill="currentColor"></path>
            </svg>
          </summary>

          <div class="dropdown-menu" role="menu">
            <div class="dropdown-label">Thème</div>

            <button type="button" class="dropdown-item theme-option" data-theme-value="light" role="menuitemradio">
              <svg class="theme-option-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                <circle cx="8" cy="8" r="3"></circle>
                <line x1="8" y1="0.5" x2="8" y2="2.5"></line>
                <line x1="8" y1="13.5" x2="8" y2="15.5"></line>
                <line x1="0.5" y1="8" x2="2.5" y2="8"></line>
                <line x1="13.5" y1="8" x2="15.5" y2="8"></line>
                <line x1="2.6" y1="2.6" x2="4" y2="4"></line>
                <line x1="12" y1="12" x2="13.4" y2="13.4"></line>
                <line x1="2.6" y1="13.4" x2="4" y2="12"></line>
                <line x1="12" y1="4" x2="13.4" y2="2.6"></line>
              </svg>
              Clair
              <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"></path></svg>
            </button>

            <button type="button" class="dropdown-item theme-option" data-theme-value="dark" role="menuitemradio">
              <svg class="theme-option-icon" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path d="M14 9.5A6.5 6.5 0 0 1 6.5 2 6.5 6.5 0 1 0 14 9.5Z"></path>
              </svg>
              Sombre
              <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"></path></svg>
            </button>

            <button type="button" class="dropdown-item theme-option" data-theme-value="system" role="menuitemradio">
              <svg class="theme-option-icon" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="8" cy="8" r="6.3" fill="none" stroke="currentColor" stroke-width="1.3"></circle>
                <path d="M8 1.7a6.3 6.3 0 0 1 0 12.6Z" fill="currentColor"></path>
              </svg>
              Système
              <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"></path></svg>
            </button>
          </div>
        </details>

        <% if authenticated? %>
          <details class="dropdown user-menu">
            <summary aria-label="Menu utilisateur">
              <%= avatar_for(Current.user.email_address, Current.user.nickname, Current.user.avatar_url, size: 28) %>
            </summary>

            <div class="dropdown-menu" role="menu">
              <div class="dropdown-label">
                Connecté en tant que<br>
                <strong><%= Current.user.display_name %></strong>
              </div>
              <div class="dropdown-divider"></div>
              <%= link_to "fastandfar.app", "https://fastandfar.app", class: "dropdown-item", target: "_blank", rel: "noopener" %>
            </div>
          </details>
        <% else %>
          <%= link_to "Se connecter", sso_bridge_url, class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </header>

    <% if notice %>
      <div class="container" style="padding-bottom: 0;"><p class="flash flash-notice"><%= notice %></p></div>
    <% end %>
    <% if alert %>
      <div class="container" style="padding-bottom: 0;"><p class="flash flash-alert"><%= alert %></p></div>
    <% end %>

    <%= yield %>

    <script>
      (function () {
        function applyTheme(theme) {
          if (theme === "light" || theme === "dark") {
            document.documentElement.setAttribute("data-theme", theme);
            localStorage.setItem("theme", theme);
          } else {
            document.documentElement.removeAttribute("data-theme");
            localStorage.removeItem("theme");
          }

          document.querySelectorAll(".theme-option").forEach(function (option) {
            option.setAttribute("aria-checked", option.dataset.themeValue === theme ? "true" : "false");
          });
        }

        function initDropdowns() {
          document.querySelectorAll(".dropdown").forEach(function (dropdown) {
            if (dropdown.dataset.bound) return;
            dropdown.dataset.bound = "true";

            dropdown.querySelectorAll(".theme-option").forEach(function (option) {
              option.addEventListener("click", function () {
                applyTheme(option.dataset.themeValue);
              });
            });

            dropdown.querySelectorAll(".dropdown-item").forEach(function (item) {
              item.addEventListener("click", function () {
                dropdown.removeAttribute("open");
              });
            });

            if (dropdown.classList.contains("type-select")) {
              var input = dropdown.querySelector('input[type="hidden"]');
              var dot = dropdown.querySelector('summary [data-role="dot"]');
              var label = dropdown.querySelector('summary [data-role="label"]');

              dropdown.querySelectorAll(".type-select-option").forEach(function (option) {
                option.addEventListener("click", function () {
                  input.value = option.dataset.value;
                  label.textContent = option.dataset.label;
                  dot.className = "type-dot type-dot-" + option.dataset.value;

                  dropdown.querySelectorAll(".type-select-option").forEach(function (opt) {
                    opt.classList.toggle("active", opt === option);
                  });

                  var pageTitleWord = document.querySelector('[data-role="type-page-title"]');
                  if (pageTitleWord) pageTitleWord.textContent = option.dataset.value;

                  var submitBtn = document.querySelector('[data-role="type-submit-btn"]');
                  if (submitBtn) submitBtn.value = submitBtn.dataset.verb + " " + option.dataset.label;
                });
              });
            }
          });

          applyTheme(localStorage.getItem("theme") || "system");
        }

        if (!window.__dropdownsOutsideClickBound) {
          window.__dropdownsOutsideClickBound = true;
          document.addEventListener("click", function (event) {
            document.querySelectorAll(".dropdown[open]").forEach(function (dropdown) {
              if (!dropdown.contains(event.target)) dropdown.removeAttribute("open");
            });
          });
        }

        function initDeleteConfirmButtons() {
          document.querySelectorAll('[data-role="delete-confirm-btn"]').forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";

            btn.addEventListener("click", function (event) {
              if (btn.dataset.armed === "true") return;
              event.preventDefault();
              btn.dataset.armed = "true";
              btn.textContent = btn.dataset.confirmLabel;
            });
          });
        }

        if (!window.__deleteConfirmOutsideClickBound) {
          window.__deleteConfirmOutsideClickBound = true;
          document.addEventListener("click", function (event) {
            document.querySelectorAll('[data-role="delete-confirm-btn"][data-armed="true"]').forEach(function (btn) {
              if (btn !== event.target) {
                btn.dataset.armed = "false";
                btn.textContent = btn.dataset.defaultLabel;
              }
            });
          });
        }

        function initCommentEditToggles() {
          document.querySelectorAll('[data-role="edit-comment-btn"]').forEach(function (btn) {
            if (btn.dataset.bound) return;
            btn.dataset.bound = "true";

            btn.addEventListener("click", function () {
              var form = document.getElementById(btn.dataset.target);
              if (form) form.classList.toggle("hidden");
            });
          });
        }

        function parseQualifierValues(str) {
          return (str || "").split(",").filter(Boolean).map(function (pair) {
            var idx = pair.indexOf(":");
            return { value: pair.slice(0, idx), label: pair.slice(idx + 1) };
          });
        }

        function fastandfarappOrigin() {
          var meta = document.querySelector('meta[name="fastandfarapp-origin"]');
          return meta ? meta.content : null;
        }

        function getTextNodesIn(el) {
          var nodes = [];
          (function walk(node) {
            if (node.nodeType === 3) {
              nodes.push(node);
            } else {
              node.childNodes.forEach(walk);
            }
          })(el);
          return nodes;
        }

        function getCaretOffset(el) {
          var selection = window.getSelection();
          if (!selection.rangeCount) return el.textContent.length;
          var range = selection.getRangeAt(0);
          if (!el.contains(range.startContainer)) return el.textContent.length;
          var preRange = document.createRange();
          preRange.selectNodeContents(el);
          preRange.setEnd(range.endContainer, range.endOffset);
          return preRange.toString().length;
        }

        function setCaretOffset(el, offset) {
          var textNodes = getTextNodesIn(el);
          var remaining = offset;
          var target = null;

          for (var i = 0; i < textNodes.length; i++) {
            if (remaining <= textNodes[i].length) {
              target = { node: textNodes[i], offset: remaining };
              break;
            }
            remaining -= textNodes[i].length;
          }

          var range = document.createRange();
          var selection = window.getSelection();

          if (target) {
            range.setStart(target.node, target.offset);
          } else if (textNodes.length) {
            var last = textNodes[textNodes.length - 1];
            range.setStart(last, last.length);
          } else {
            range.setStart(el, 0);
          }

          range.collapse(true);
          selection.removeAllRanges();
          selection.addRange(range);
        }

        function tokenAt(text, pos) {
          var start = text.lastIndexOf(" ", pos - 1) + 1;
          var end = text.indexOf(" ", pos);
          if (end === -1) end = text.length;
          return { text: text.slice(start, end), start: start, end: end };
        }

        function getCaretRect(el) {
          var selection = window.getSelection();
          if (!selection.rangeCount) return null;
          var range = selection.getRangeAt(0);
          if (!el.contains(range.startContainer)) return null;

          var caretRange = range.cloneRange();
          caretRange.collapse(true);
          var rects = caretRange.getClientRects();
          if (rects.length) return rects[0];

          var rect = caretRange.getBoundingClientRect();
          if (rect.width || rect.height || rect.top || rect.left) return rect;

          return null;
        }

        function initSearchAutocomplete() {
          document.querySelectorAll('[data-role="search-qualifier-input"]').forEach(function (editor) {
            if (editor.dataset.bound) return;
            editor.dataset.bound = "true";

            var wrap = editor.closest(".post-search-form");
            var list = wrap.querySelector('[data-role="search-suggestions"]');
            var hiddenField = wrap.querySelector('[data-role="search-qualifier-value"]');
            var qualifiers = [
              { key: "is", values: parseQualifierValues(editor.dataset.types) },
              { key: "state", values: parseQualifierValues(editor.dataset.statuses) },
              { key: "author", values: [], dynamic: true }
            ];
            var activeIndex = -1;
            var authorDebounceTimer = null;
            var authorRequestToken = 0;

            function isValidToken(token) {
              var match = token.match(/^(is|state|author):(.+)$/i);
              if (!match) return false;
              var qualifier = qualifiers.find(function (q) { return q.key === match[1].toLowerCase(); });
              if (!qualifier) return false;
              // author values come from a live nickname search, not a fixed list:
              // any non-empty value the user accepted is trusted as-is.
              if (qualifier.dynamic) return true;
              var value = match[2].toLowerCase();
              return qualifier.values.some(function (option) { return option.value.toLowerCase() === value; });
            }

            function buildChip(token) {
              var match = token.match(/^(is|state|author):(.+)$/i);
              var chip = document.createElement("span");
              chip.className = "search-chip";
              chip.contentEditable = "false";

              var qualifierLabel = document.createElement("span");
              qualifierLabel.className = "search-chip-qualifier";
              qualifierLabel.textContent = match[1].toLowerCase() + ":";
              chip.appendChild(qualifierLabel);
              chip.appendChild(document.createTextNode(match[2]));

              return chip;
            }

            // Renders text into the editor as chips for completed, valid is:/state:
            // tokens, plain highlighted text for the token currently being typed
            // (between activeStart/activeEnd) and free-text search terms.
            function renderQuery(text, activeStart, activeEnd) {
              editor.textContent = "";
              var idx = 0;

              text.split(/(\s+)/).forEach(function (part) {
                var partStart = idx;
                idx += part.length;
                if (part === "" || /^\s+$/.test(part)) {
                  if (part !== "") editor.appendChild(document.createTextNode(part));
                  return;
                }

                var isActive = activeStart != null && partStart === activeStart && partStart + part.length === activeEnd;

                if (!isActive && isValidToken(part)) {
                  editor.appendChild(buildChip(part));
                  return;
                }

                var match = part.match(/^(is|state|author):(.*)$/i);
                if (match) {
                  editor.appendChild(document.createTextNode(match[1] + ":"));
                  var value = document.createElement("span");
                  value.className = "criterion-value";
                  value.textContent = match[2];
                  editor.appendChild(value);
                } else {
                  editor.appendChild(document.createTextNode(part));
                }
              });

              hiddenField.value = text;
            }

            function currentToken() {
              return tokenAt(editor.textContent, getCaretOffset(editor));
            }

            function computeSuggestions(text) {
              var colonIndex = text.indexOf(":");
              var suggestions = [];

              if (colonIndex === -1) {
                if (text.length > 0) {
                  qualifiers.forEach(function (qualifier) {
                    if (qualifier.key.indexOf(text.toLowerCase()) === 0) {
                      suggestions.push({ insert: qualifier.key + ":", display: qualifier.key + ":", hint: "", bare: true });
                    }
                  });
                }
              } else {
                var key = text.slice(0, colonIndex).toLowerCase();
                var valuePrefix = text.slice(colonIndex + 1).toLowerCase();
                var qualifier = qualifiers.find(function (q) { return q.key === key; });

                if (qualifier) {
                  qualifier.values.forEach(function (option) {
                    if (option.value.toLowerCase().indexOf(valuePrefix) === 0) {
                      suggestions.push({ insert: key + ":" + option.value, display: key + ":" + option.value, hint: option.label });
                    }
                  });
                }
              }

              return suggestions;
            }

            function hideSuggestions() {
              list.classList.add("hidden");
              list.innerHTML = "";
              activeIndex = -1;
            }

            function positionSuggestions() {
              var wrapRect = wrap.getBoundingClientRect();
              var caretRect = getCaretRect(editor);

              if (caretRect) {
                list.style.left = (caretRect.left - wrapRect.left) + "px";
                list.style.top = (caretRect.bottom - wrapRect.top + 6) + "px";
              } else {
                list.style.left = "0px";
                list.style.top = "calc(100% + 6px)";
              }
            }

            function setActive(index) {
              var items = list.querySelectorAll(".search-suggestion-item");
              if (!items.length) return;
              if (items[activeIndex]) items[activeIndex].classList.remove("active-suggestion");
              activeIndex = (index + items.length) % items.length;
              items[activeIndex].classList.add("active-suggestion");
              items[activeIndex].scrollIntoView({ block: "nearest" });
            }

            function bareQualifierSuggestions() {
              return qualifiers.map(function (qualifier) {
                return { insert: qualifier.key + ":", display: qualifier.key + ":", hint: "", bare: true };
              });
            }

            function applySuggestion(suggestion, token) {
              var text = editor.textContent;
              var before = text.slice(0, token.start);
              var after = text.slice(token.end);
              var separator = suggestion.bare ? "" : " ";
              var newText = before + suggestion.insert + separator + after;
              var caretPos = (before + suggestion.insert + separator).length;

              renderQuery(newText, null, null);
              editor.focus();
              setCaretOffset(editor, caretPos);

              if (suggestion.bare) {
                // Accepted a bare qualifier (e.g. "is:") -> show its values.
                updateSuggestions();
              } else {
                // Accepted a value (e.g. "is:idea") -> offer the available
                // filter criteria again so another one can be chained.
                renderSuggestionList(bareQualifierSuggestions(), currentToken());
              }
            }

            function renderSuggestionList(suggestions, token) {
              list.innerHTML = "";
              activeIndex = suggestions.length ? 0 : -1;

              suggestions.forEach(function (suggestion, index) {
                var item = document.createElement("button");
                item.type = "button";
                item.className = "dropdown-item search-suggestion-item" + (index === 0 ? " active-suggestion" : "");
                item.setAttribute("role", "option");

                var code = document.createElement("code");
                code.textContent = suggestion.display;
                item.appendChild(code);

                if (suggestion.hint) {
                  var hint = document.createElement("span");
                  hint.className = "search-suggestion-hint";
                  hint.textContent = suggestion.hint;
                  item.appendChild(hint);
                }

                item.addEventListener("mousedown", function (event) { event.preventDefault(); });
                item.addEventListener("click", function () { applySuggestion(suggestion, token); });
                list.appendChild(item);
              });

              if (suggestions.length) positionSuggestions();
              list.classList.toggle("hidden", suggestions.length === 0);
            }

            function fetchAuthorSuggestions(token, valuePrefix) {
              // "me" is a synthetic shortcut (resolved server-side to the current
              // user) rather than a real nickname, so offer it instantly without
              // waiting on the network whenever it matches what's been typed.
              var meSuggestion = "me".indexOf(valuePrefix.toLowerCase()) === 0
                ? [ { insert: "author:me", display: "author:me", hint: "Yourself" } ]
                : [];

              if (meSuggestion.length) renderSuggestionList(meSuggestion, token);

              var origin = fastandfarappOrigin();
              if (!origin) {
                if (!meSuggestion.length) renderSuggestionList([], token);
                return;
              }

              clearTimeout(authorDebounceTimer);
              var requestToken = ++authorRequestToken;

              authorDebounceTimer = setTimeout(function () {
                fetch(origin + "/api/store/mentions/search?q=" + encodeURIComponent(valuePrefix), { credentials: "include" })
                  .then(function (response) { return response.ok ? response.json() : { nicknames: [] }; })
                  .then(function (data) {
                    if (requestToken !== authorRequestToken) return; // a newer keystroke superseded this request

                    var nicknameSuggestions = (data.nicknames || []).map(function (nickname) {
                      return { insert: "author:" + nickname, display: "author:" + nickname, hint: "" };
                    });
                    renderSuggestionList(meSuggestion.concat(nicknameSuggestions), token);
                  })
                  .catch(function () {
                    if (!meSuggestion.length) renderSuggestionList([], token);
                  });
              }, 150);
            }

            function updateSuggestions() {
              var token = currentToken();
              var colonIndex = token.text.indexOf(":");

              if (colonIndex !== -1 && token.text.slice(0, colonIndex).toLowerCase() === "author") {
                fetchAuthorSuggestions(token, token.text.slice(colonIndex + 1));
                return;
              }

              renderSuggestionList(computeSuggestions(token.text), token);
            }

            renderQuery(editor.textContent, null, null);

            editor.addEventListener("input", function () {
              var caretOffset = getCaretOffset(editor);
              var text = editor.textContent;
              var token = tokenAt(text, caretOffset);

              renderQuery(text, token.start, token.end);
              setCaretOffset(editor, caretOffset);
              updateSuggestions();
            });
            editor.addEventListener("focus", updateSuggestions);

            editor.addEventListener("keydown", function (event) {
              if (event.key === "Enter") {
                event.preventDefault();
                if (!list.classList.contains("hidden") && activeIndex !== -1) {
                  list.querySelectorAll(".search-suggestion-item")[activeIndex].click();
                } else {
                  wrap.requestSubmit();
                }
                return;
              }

              if (event.key === "Backspace") {
                var selection = window.getSelection();
                var collapsed = !selection.rangeCount || selection.getRangeAt(0).collapsed;

                if (collapsed) {
                  var caretOffset = getCaretOffset(editor);
                  var text = editor.textContent;
                  var precedingToken = tokenAt(text, caretOffset);

                  if (precedingToken.end === caretOffset && isValidToken(precedingToken.text)) {
                    event.preventDefault();

                    var before = text.slice(0, precedingToken.start);
                    var after = text.slice(precedingToken.end);
                    if (after.charAt(0) === " ") {
                      after = after.slice(1);
                    } else if (before.charAt(before.length - 1) === " ") {
                      before = before.slice(0, -1);
                    }

                    renderQuery(before + after, null, null);
                    editor.focus();
                    setCaretOffset(editor, before.length);
                    updateSuggestions();
                    return;
                  }
                }
              }

              if (list.classList.contains("hidden")) return;

              if (event.key === "ArrowDown") {
                event.preventDefault();
                setActive(activeIndex + 1);
              } else if (event.key === "ArrowUp") {
                event.preventDefault();
                setActive(activeIndex - 1);
              } else if (event.key === "Escape") {
                hideSuggestions();
              }
            });
          });
        }

        if (!window.__searchSuggestionsOutsideClickBound) {
          window.__searchSuggestionsOutsideClickBound = true;
          document.addEventListener("click", function (event) {
            // Use composedPath (the path frozen at dispatch time) instead of
            // wrap.contains(event.target): selecting a suggestion rebuilds the
            // list and detaches the clicked button before this bubbles here,
            // which would make a contains() check see it as "outside".
            var path = event.composedPath ? event.composedPath() : null;

            document.querySelectorAll('[data-role="search-suggestions"]:not(.hidden)').forEach(function (list) {
              var wrap = list.closest(".post-search-form");
              if (!wrap) return;

              var insideWrap = path ? path.indexOf(wrap) !== -1 : wrap.contains(event.target);
              if (!insideWrap) {
                list.classList.add("hidden");
                list.innerHTML = "";
              }
            });
          });
        }

        initDropdowns();
        initDeleteConfirmButtons();
        initCommentEditToggles();
        initSearchAutocomplete();
        document.addEventListener("turbo:load", initDropdowns);
        document.addEventListener("turbo:load", initDeleteConfirmButtons);
        document.addEventListener("turbo:load", initCommentEditToggles);
        document.addEventListener("turbo:load", initSearchAutocomplete);
      })();
    </script>
  </body>
</html>
