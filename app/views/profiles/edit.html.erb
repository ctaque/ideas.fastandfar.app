<h1>Mon profil</h1>

<%= tag.div(flash[:alert], style: "color:red") if flash[:alert] %>
<%= tag.div(flash[:notice], style: "color:green") if flash[:notice] %>

<% if @user.errors.any? %>
  <div style="color:red">
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with url: profile_path, method: :patch do |form| %>
  <%= form.label :email_address, "Adresse e-mail" %>
  <%= form.email_field :email_address, required: true, autocomplete: "username", value: @user.email_address %><br>

  <%= form.label :password, "Nouveau mot de passe (laisser vide pour ne pas changer)" %>
  <%= form.password_field :password, autocomplete: "new-password", placeholder: "Nouveau mot de passe", maxlength: 72 %><br>

  <%= form.label :password_confirmation, "Confirmer le nouveau mot de passe" %>
  <%= form.password_field :password_confirmation, autocomplete: "new-password", placeholder: "Confirmer le nouveau mot de passe", maxlength: 72 %><br>

  <%= form.label :current_password, "Mot de passe actuel" %>
  <%= form.password_field :current_password, required: true, autocomplete: "current-password", placeholder: "Requis pour confirmer les changements", maxlength: 72 %><br>

  <%= form.submit "Enregistrer" %>
<% end %>
