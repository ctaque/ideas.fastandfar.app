<% content_for :title, "Ideas" %>

<div class="container">
  <div class="page-header" style="align-items: flex-start;">
    <%= form_with url: posts_path, method: :get, class: "post-search-form" do %>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :q, @q, data: { role: "search-qualifier-value" } %>
      <div class="post-search-input" contenteditable="true" role="textbox" aria-multiline="false"
           spellcheck="false" data-role="search-qualifier-input" data-placeholder="is:idea state:open"
           data-types="<%= Post.types.keys.map { |type| "#{type}:#{type_label(type)}" }.join(",") %>"
           data-statuses="<%= Post.statuses.keys.map { |status| "#{status}:#{status_label(status)}" }.join(",") %>"><%= @q %></div>
      <div class="post-search-suggestions hidden" data-role="search-suggestions" role="listbox"></div>
    <% end %>

    <div style="display: flex; gap: 8px;">
      <% sort_labels = { "new" => "Newest", "top" => "Top", "updated" => "Recently updated" } %>
      <details class="dropdown">
        <summary class="btn btn-sm">
          Sort: <%= sort_labels[@sort] %>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 6h8l-4 5Z"></path></svg>
        </summary>

        <div class="dropdown-menu" role="menu">
          <% sort_labels.each do |value, label| %>
            <%= link_to label, posts_path(sort: value, q: @q), class: "dropdown-item #{"active" if @sort == value}" %>
          <% end %>
        </div>
      </details>

      <%= link_to "New", new_post_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div id="posts" class="list-box">
    <% if @posts.any? %>
      <%= render @posts %>
    <% else %>
      <div class="empty-state">
        <%= image_tag "elephant.svg", class: "empty-state-icon", alt: "" %>
        <div>No ideas, feature or bug yet — be the first to write one.</div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <div class="pagination">
      <% if @page > 1 %>
        <%= link_to "← Previous", posts_path(sort: @sort, q: @q, page: @page - 1), class: "btn btn-sm" %>
      <% else %>
        <span class="btn btn-sm" aria-disabled="true">← Previous</span>
      <% end %>

      <span class="pagination-info">Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Next →", posts_path(sort: @sort, q: @q, page: @page + 1), class: "btn btn-sm" %>
      <% else %>
        <span class="btn btn-sm" aria-disabled="true">Next →</span>
      <% end %>
    </div>
  <% end %>
</div>
