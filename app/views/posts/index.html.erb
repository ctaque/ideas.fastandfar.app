<% content_for :title, "Ideas" %>

<div class="container">
  <div class="page-header" style="justify-content: flex-end;">
    <div style="display: flex; gap: 8px;">
      <details class="dropdown">
        <summary class="btn btn-sm">
          Type: <%= @type ? type_label(@type) : "All" %>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 6h8l-4 5Z"></path></svg>
        </summary>

        <div class="dropdown-menu" role="menu">
          <div class="dropdown-label">Filter by type</div>
          <div class="dropdown-divider"></div>

          <%= link_to posts_path(sort: @sort), class: "dropdown-item #{"active" if @type.nil?}" do %>
            <span class="type-dot type-dot-all"></span>
            All
            <% if @type.nil? %>
              <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"></path></svg>
            <% end %>
          <% end %>

          <% Post.types.each_key do |type| %>
            <%= link_to posts_path(sort: @sort, type: type), class: "dropdown-item #{"active" if @type == type}" do %>
              <span class="type-dot type-dot-<%= type %>"></span>
              <%= type_label(type) %>
              <% if @type == type %>
                <svg class="check" width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4"></path></svg>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </details>

      <% sort_labels = { "new" => "Newest", "top" => "Top", "updated" => "Recently updated" } %>
      <details class="dropdown">
        <summary class="btn btn-sm">
          Sort: <%= sort_labels[@sort] %>
          <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 6h8l-4 5Z"></path></svg>
        </summary>

        <div class="dropdown-menu" role="menu">
          <% sort_labels.each do |value, label| %>
            <%= link_to label, posts_path(sort: value, type: @type), class: "dropdown-item #{"active" if @sort == value}" %>
          <% end %>
        </div>
      </details>

      <%= link_to "New", new_post_path, class: "btn btn-primary" %>
    </div>
  </div>

  <div id="posts" class="list-box">
    <% if @posts.any? %>
      <%= render @posts %>
    <% else %>
      <div class="empty-state">
        <%= image_tag "elephant.svg", class: "empty-state-icon", alt: "" %>
        <div>No ideas, feature or bug yet — be the first to write one.</div>
      </div>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <div class="pagination">
      <% if @page > 1 %>
        <%= link_to "← Previous", posts_path(sort: @sort, type: @type, page: @page - 1), class: "btn btn-sm" %>
      <% else %>
        <span class="btn btn-sm" aria-disabled="true">← Previous</span>
      <% end %>

      <span class="pagination-info">Page <%= @page %> of <%= @total_pages %></span>

      <% if @page < @total_pages %>
        <%= link_to "Next →", posts_path(sort: @sort, type: @type, page: @page + 1), class: "btn btn-sm" %>
      <% else %>
        <span class="btn btn-sm" aria-disabled="true">Next →</span>
      <% end %>
    </div>
  <% end %>
</div>
