<% content_for :title, @post.title %>

<div class="container">
  <%= link_to "← Back to list", posts_path, class: "back-link" %>

  <div style="display: flex; gap: 16px; align-items: flex-start;">
    <%= render "votes/widget", post: @post %>

    <div style="flex: 1; min-width: 0;">
      <h1 class="issue-title"><%= @post.title %></h1>
      <div class="issue-meta">
        <%= avatar_for(@post.user_email, @post.user_nickname, size: 20) %>
        <span><%= display_name_for(@post.user_email, @post.user_nickname) %> posted on <%= @post.created_at.strftime("%b %d, %Y") %></span>
      </div>

      <div class="issue-actions">
        <span class="<%= type_badge_class(@post.type) %>"><%= type_label(@post.type) %></span>

        <% if Current.user.admin? %>
          <details class="dropdown status-dropdown">
            <summary class="<%= status_badge_class(@post.status) %>">
              <%= status_label(@post.status) %>
              <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M4 6h8l-4 5Z"></path></svg>
            </summary>

            <div class="dropdown-menu" role="menu">
              <% Post.statuses.each_key do |status| %>
                <%= button_to status_label(status), post_status_path(@post), method: :patch, params: { status: status },
                      class: "dropdown-item #{"active" if @post.status == status}" %>
              <% end %>
            </div>
          </details>
        <% else %>
          <span class="<%= status_badge_class(@post.status) %>"><%= status_label(@post.status) %></span>
        <% end %>

        <%= link_to "Edit", edit_post_path(@post), class: "btn btn-sm" %>
        <%= button_to "Delete", @post, method: :delete, class: "btn btn-sm btn-danger", form: { data: { turbo_confirm: "Are you sure?" } } %>
      </div>
    </div>
  </div>

  <div class="content-box">
    <div class="content-box-header">Idea</div>
    <div class="content-box-body"><%= @post.content %></div>
  </div>

  <h2><%= pluralize(@post.comments.count, "comment") %></h2>

  <div id="comments">
    <%= render @post.comments %>
  </div>

  <%= render "comments/form", post: @post, comment: @post.comments.build %>
</div>
