<div id="<%= dom_id post %>" class="list-row">
  <%= render "votes/widget", post: post %>

  <div class="list-row-body">
    <%= link_to post.title, post, class: "list-row-title" %>
    <span class="<%= type_badge_class(post.type) %>"><%= type_label(post.type) %></span>
    <% unless post.open? %>
      <span class="<%= status_badge_class(post.status) %>"><%= status_label(post.status) %></span>
    <% end %>
    <p class="list-row-excerpt"><%= truncate(post.content.to_plain_text, length: 200) %></p>
    <div class="list-row-meta">
      <%= avatar_for(post.user_email, post.user_nickname, size: 16) %>
      <%= display_name_for(post.user_email, post.user_nickname) %>
      <span>&middot;</span>
      <span><%= post.created_at.strftime("%b %d, %Y") %></span>
    </div>
  </div>
</div>
