<div class="comment-form-box">
  <%= form_with model: comment, url: post_comments_path(post), local: true do |form| %>
    <div class="field">
      <%= form.label :comment, "Add a comment" %>
      <%= form.textarea :comment %>
    </div>

    <%= form.submit "Comment", class: "btn btn-primary" %>
  <% end %>
</div>
