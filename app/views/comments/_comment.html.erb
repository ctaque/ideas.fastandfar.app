<div id="<%= dom_id comment %>" class="timeline-item">
  <%= avatar_for(comment.user_email, size: 32) %>

  <div class="timeline-content">
    <div class="timeline-content-header">
      <strong><%= comment.user_email %></strong>
      <% if comment.user_id == Current.user.id || Current.user.admin? %>
        <%= button_to "Delete", [ comment.post, comment ], method: :delete, class: "btn btn-sm btn-danger" %>
      <% end %>
    </div>
    <div class="timeline-content-body"><%= comment.comment %></div>
  </div>
</div>
