<%
  subscribed = post.subscribed_by?(Current.user)
%>
<div class="sidebar-label">Notifications</div>
<%= button_to post_subscription_path(post), method: :post,
      class: "btn #{"btn-primary" if subscribed}",
      aria: { pressed: subscribed.to_s } do %>
  <% if subscribed %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
    Subscribed
  <% else %>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
      <line x1="3" y1="3" x2="21" y2="21"></line>
    </svg>
    Subscribe
  <% end %>
<% end %>

<p class="subscribe-status">
  <% if subscribed %>
    You're receiving updates from this post
  <% else %>
    You're not receiving updates from this post
  <% end %>
</p>
